{
  "version": 2,
  "builds": [
    {
      "src": "stock_api.js",
      "use": "@vercel/node"
    },
    {
      "src": "travel_server.js",
      "use": "@vercel/node"
    },
    {
      "src": "insurance_api.js",
      "use": "@vercel/node"
    },
    {
      "src": "usa_stock_api.js",
      "use": "@vercel/node"
    },
    {
      "src": "stock_prices_api.js",
      "use": "@vercel/node"
    },
    {
      "src": "structured_products_api.js",
      "use": "@vercel/node"
    },
    {
      "src": "f_blacklist_api.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/stock-prices",
      "dest": "stock_prices_api.js"
    },
    {
      "src": "/api/usa-stock",
      "dest": "usa_stock_api.js"
    },
    {
      "src": "/api/stock/(.*)",
      "dest": "stock_api.js"
    },
    {
      "src": "/api/stock",
      "dest": "stock_api.js"
    },
    {
      "src": "/api/travel/(.*)",
      "dest": "travel_server.js"
    },
    {
      "src": "/api/travel",
      "dest": "travel_server.js"
    },
    {
      "src": "/api/insurance/(.*)",
      "dest": "insurance_api.js"
    },
    {
      "src": "/api/insurance",
      "dest": "insurance_api.js"
    },
    {
      "src": "/api/structured-products/(.*)",
      "dest": "structured_products_api.js"
    },
    {
      "src": "/api/structured-products",
      "dest": "structured_products_api.js"
    },
    {
      "src": "/api/f-blacklist/(.*)",
      "dest": "f_blacklist_api.js"
    }
  ]
}
