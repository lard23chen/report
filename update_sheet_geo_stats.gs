// 使用方式：
// 1. 開啟試算表 → 擴充功能 → Apps Script
// 2. 貼上此程式碼，取代原有內容
// 3. 點「執行」→ updateGeoStats
// 4. 授權後等待完成即可

function updateGeoStats() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];

  // [列號, 台灣筆數/張數, 海外筆數/張數, 台灣占比, 海外占比, 內部訂單, IP無法辨識]
  // 欄位對應：F=6, G=7, H=8, I=9, J=10, K=11
  const rows = [
    [2,  '1488筆/4144張', '124筆/166張',  '92.3%', '7.7%',  '146筆', '11筆'],
    [3,  '1642筆/2290張', '125筆/179張',  '92.9%', '7.1%',  '345筆', '12筆'],
    [4,  '596筆/952張',   '25筆/29張',    '96.0%', '4.0%',  '85筆',  '1筆' ],
    [5,  '703筆/1899張',  '74筆/136張',   '90.5%', '9.5%',  '282筆', '6筆' ],
    [6,  '503筆/1883張',  '54筆/57張',    '90.3%', '9.7%',  '68筆',  '1筆' ],
    [7,  '487筆/1469張',  '34筆/39張',    '93.5%', '6.5%',  '61筆',  '1筆' ],
    [8,  '1425筆/3352張', '35筆/63張',    '97.6%', '2.4%',  '161筆', '3筆' ],
    [9,  '2450筆/4556張', '89筆/158張',   '96.5%', '3.5%',  '630筆', '0筆' ],
    [10, '1892筆/3160張', '91筆/132張',   '95.4%', '4.6%',  '110筆', '1筆' ],
    [11, '1485筆/2705張', '89筆/190張',   '94.3%', '5.7%',  '104筆', '0筆' ],
    [12, '672筆/808張',   '95筆/128張',   '87.6%', '12.4%', '122筆', '7筆' ],
    [13, '983筆/1943張',  '17筆/28張',    '98.3%', '1.7%',  '95筆',  '0筆' ],
    [14, '8834筆/15945張','207筆/338張',  '97.7%', '2.3%',  '108筆', '0筆' ],
    [15, '983筆/1943張',  '17筆/28張',    '98.3%', '1.7%',  '95筆',  '0筆' ],
    // 列16 (SEVENUS) 無搶票時間，跳過
    [17, '414筆/517張',   '42筆/57張',    '90.8%', '9.2%',  '70筆',  '0筆' ],
    [18, '1168筆/1381張', '73筆/87張',    '94.1%', '5.9%',  '7筆',   '6筆' ],
  ];

  rows.forEach(([rowNum, tw, ov, twPct, ovPct, int_, unk]) => {
    sheet.getRange(rowNum, 6).setValue(tw);
    sheet.getRange(rowNum, 7).setValue(ov);
    sheet.getRange(rowNum, 8).setValue(twPct);
    sheet.getRange(rowNum, 9).setValue(ovPct);
    sheet.getRange(rowNum, 10).setValue(int_);
    sheet.getRange(rowNum, 11).setValue(unk);
  });

  SpreadsheetApp.getUi().alert('✅ 完成！共更新 ' + rows.length + ' 筆活動資料。');
}
